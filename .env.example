# === SECURITY NOTICE ===
# This is a template. NEVER commit real API keys to git.
# Copy to Code/.env :  cp .env.example Code/.env
# Then replace the placeholder below with your real DeepSeek API key.
# If you suspect a key has been committed, rotate it immediately:
#   1. Go to https://platform.deepseek.com/api_keys
#   2. Create a new key, copy it
#   3. Delete the old key
#   4. Update Code/.env with the new key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Local server
HUXIN_HOST=0.0.0.0
HUXIN_PORT=8000

# Paths are resolved relative to the project root when not absolute.
CHROMA_DB_PATH=Model/chroma_db
CHAT_LOG_PATH=Log/justitia_chat_logs.jsonl
LEGAL_DATA_PATH=Data

# Keep 1 when BAAI/bge-m3 is already cached locally; set 0 to allow first-time download.
HF_OFFLINE=1
