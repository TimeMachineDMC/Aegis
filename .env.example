DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Local server
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8080

# Paths are resolved relative to the project root when not absolute.
CHROMA_DB_PATH=Model/chroma_db
CHAT_LOG_PATH=Log/aegis_chat_logs.jsonl
LEGAL_DATA_PATH=Data

# LLM config (optional: defaults shown)
# LLM_MODEL=deepseek-chat
# LLM_MAX_TOKENS=8192

# Keep 1 when BAAI/bge-m3 is already cached locally; set 0 to allow first-time download.
HF_OFFLINE=1
